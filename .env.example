# Environment example for Panagang PH
# Copy to .env and fill in secrets. Never commit .env.

# API
API_HOST=0.0.0.0
API_PORT=8080
RUST_LOG=panagang_api=info,tower_http=info

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgres://panagang:panagang@localhost:5433/panagang

# Redis
REDIS_URL=redis://localhost:6379

# Anonymous device token signing (replace in any shared environment)
DEVICE_TOKEN_SECRET=change-me-dev-only-secret

# LLM (Phase 3+) — Gemini free tier by default
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=http://localhost:11434
